# DO NOT APPLY THIS FILE DIRECTLY IN PRODUCTION.
#
# This is a template for local development / kubectl dry-runs only.
# In production, the Secret is created by the CI/CD pipeline using GitHub
# Actions secrets (see .github/workflows/ci-cd-billing-service.yml). Manually
# applying this file would overwrite the production credentials with the
# placeholder values below and break the service (UnknownHostException on the
# JDBC URL, authentication failures, etc.).
#
# For local Docker Compose runs use the values in docker-compose.yml instead.
apiVersion: v1
kind: Secret
metadata:
  name: billing-service-secret
  namespace: billing-service
type: Opaque
stringData:
  SPRING_DATASOURCE_URL: "jdbc:postgresql://postgres-billing:5432/billing_service"
  SPRING_DATASOURCE_USERNAME: "postgres"
  SPRING_DATASOURCE_PASSWORD: "CHANGE_ME"
  RABBITMQ_USERNAME: "guest"
  RABBITMQ_PASSWORD: "guest"
  MERCADOPAGO_ACCESS_TOKEN: "CHANGE_ME"
